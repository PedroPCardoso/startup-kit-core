{
    "name": "cardoso/startup-kit-core",
    "description": "Startup Kit — Core package: primitives, value objects, contracts, and cross-cutting infrastructure",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/log": "^12.0",
        "illuminate/config": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Cardoso\\StartupKit\\Core\\": "src/Core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cardoso\\StartupKit\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cardoso\\StartupKit\\Core\\StartupKitCoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
